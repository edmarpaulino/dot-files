# Tipografia (Essencial para Oh My Posh)
font-family = "JetBrainsMono Nerd Font"
font-size = 18
font-feature = calt
font-feature = liga

# Estética macOS
# theme = dark
background-opacity = 1
background-blur-radius = 20
window-padding-x = 8
window-padding-y = 8
window-decoration = true

# Integração com Shell
command = /bin/zsh --login

# Cursor e Mouse
cursor-style = bar
cursor-style-blink = true
mouse-hide-while-typing = true

# Atalhos úteis (Split de tela estilo VS Code)
# Navegar entre splits usando Command + HJKL
keybind = cmd+h=goto_split:left
keybind = cmd+j=goto_split:bottom
keybind = cmd+k=goto_split:top
keybind = cmd+l=goto_split:right

keybind = cmd+shift+h=resize_split:left,10
keybind = cmd+shift+j=resize_split:down,10
keybind = cmd+shift+k=resize_split:up,10
keybind = cmd+shift+l=resize_split:right,10

